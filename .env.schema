# @defaultRequired=false
# @defaultSensitive=false
# ---

# Local Postgres connection. Override in .env.local for your machine.
# @required @type=url(allowedProtocols=[postgres, postgresql]) @sensitive
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nova_hub
DATABASE_POOL_MAX=10

# HMAC signing secret for API access tokens.
# @sensitive
AUTH_SECRET=

# API server port.
# @type=port
PORT=3001

# Comma-separated browser origins allowed by the API.
CORS_ORIGIN=http://localhost:5173

# Enable OpenTelemetry exporters.
# @type=boolean
OTEL_ENABLED=true

# API URL exposed to the Vite app.
# @type=url
VITE_API_URL=http://localhost:3001

# OpenAI-compatible URL reachable from the API container (defaults to local LiteLLM).
# @type=url
COMPOSE_LLM_BASE_URL=http://litellm:4000/v1

# Select the OpenAI-compatible adapter or deterministic mock. Live local verification uses the LiteLLM alias.
# @type=enum(mock,openai-compatible) @sensitive=false
LLM_PROVIDER=mock
# @type=url @sensitive=false
LLM_BASE_URL=http://localhost:4000/v1
# @sensitive=false
LLM_MODEL=lesson-planner
# Generation and advisory-review aliases can differ. LLM_MODEL remains a compatibility fallback.
# @sensitive=false
LLM_GENERATOR_MODEL=lesson-planner
# @sensitive=false
LLM_REVIEWER_MODEL=lesson-planner
# The reviewer evaluates a full plan and curriculum evidence; allow longer responses than generation.
# @type=number(precision=0, min=20000, max=180000) @sensitive=false
LLM_REVIEW_TIMEOUT_MS=90000
# Maximum generated output tokens per model call; bounded to protect providers and cost.
# @type=number(precision=0, min=1, max=16384) @sensitive=false
LLM_MAX_OUTPUT_TOKENS=8192
# @sensitive=true
LLM_API_KEY=

# Local embeddings need no provider key. Weight cache and vector-result cache are separate.
# @type=enum(local,mock) @sensitive=false
EMBEDDING_PROVIDER=local
# @sensitive=false
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Set an immutable Hugging Face commit to pin artifacts; update it with EMBEDDING_MODEL.
# @sensitive=false
EMBEDDING_MODEL_REVISION=main
# @type=number(precision=0, min=1) @sensitive=false
EMBEDDING_DIMENSIONS=384
# @type=boolean @sensitive=false
EMBEDDING_CACHE_ENABLED=true
# @sensitive=false
EMBEDDING_CACHE_DIR=.cache/embeddings
# @sensitive=false
TRANSFORMERS_CACHE_DIR=.cache/transformers

# CLI run reports are local artifacts and stay out of Git.
NOVA_EVAL_REPORTS_DIR=.cache/evals/runs

# LiteLLM infrastructure/admin settings.
# @type=url
LITELLM_BASE_URL=http://localhost:4000/v1
# LiteLLM's Baseten provider credentials and endpoint.
# @type=url
BASETEN_BASE_URL=https://inference.baseten.co/v1
# @sensitive
BASETEN_API_KEY=
# @type=url(allowedProtocols=[postgres, postgresql]) @sensitive
LITELLM_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/litellm
# @sensitive
LITELLM_MASTER_KEY=
# @sensitive
LITELLM_POSTGRES_PASSWORD=
# @sensitive
LITELLM_SALT_KEY=

# Optional Langfuse tracing credentials.
# @sensitive
LANGFUSE_PUBLIC_KEY=
# @sensitive
LANGFUSE_SECRET_KEY=
# @type=url
LANGFUSE_HOST=http://localhost:3002
# @type=url
LANGFUSE_BASE_URL=http://localhost:3002
# @type=url
COMPOSE_LANGFUSE_BASE_URL=http://langfuse-web:3000
# @type=url
LANGFUSE_MEDIA_URL=http://localhost:9092
# Local Langfuse infrastructure and headless project setup. Keep secrets in .env.local.
# @sensitive
LANGFUSE_POSTGRES_PASSWORD=
# @sensitive
LANGFUSE_CLICKHOUSE_PASSWORD=
# @sensitive
LANGFUSE_REDIS_AUTH=
# @sensitive
LANGFUSE_MINIO_ROOT_PASSWORD=
# @sensitive
LANGFUSE_NEXTAUTH_SECRET=
# @sensitive
LANGFUSE_SALT=
# @sensitive
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_ORG_ID=nova
LANGFUSE_INIT_ORG_NAME=Nova
LANGFUSE_INIT_PROJECT_ID=nova
LANGFUSE_INIT_PROJECT_NAME=Nova Takehome
LANGFUSE_INIT_USER_EMAIL=admin@example.test
LANGFUSE_INIT_USER_NAME=Nova Admin
# @sensitive
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_MINIO_ROOT_USER=langfuse
# @type=boolean
LANGFUSE_CAPTURE_PROMPTS=true
# @type=boolean
LANGFUSE_USE_MANAGED_PROMPTS=true
LANGFUSE_PROMPT_LABEL=production

# OpenTelemetry resource and collector settings.
OTEL_SERVICE_NAME=nova-api
# @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
