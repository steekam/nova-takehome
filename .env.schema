# @defaultRequired=false
# @defaultSensitive=false
# ---

# Local Postgres connection. Override in .env.local for your machine.
# @required @type=url(allowedProtocols=[postgres, postgresql]) @sensitive
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nova_hub

# HMAC signing secret for API access tokens.
# @sensitive
AUTH_SECRET=

# API server port.
# @type=port
PORT=3001

# Comma-separated browser origins allowed by the API.
CORS_ORIGIN=http://localhost:5173

# Enable OpenTelemetry exporters.
# @type=boolean
OTEL_ENABLED=false

# API URL exposed to the Vite app.
# @type=url
VITE_API_URL=http://localhost:3001

# Select the LLM backend.
# @type=enum(mock,litellm)
LLM_MODE=mock

# LiteLLM endpoint and credentials.
# @type=url
LITELLM_BASE_URL=http://localhost:4000/v1
# @sensitive
LITELLM_API_KEY=
LITELLM_MODEL=lesson-planner
# @type=url(allowedProtocols=[postgres, postgresql]) @sensitive
LITELLM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/litellm
# @sensitive
LITELLM_MASTER_KEY=

# Provider credential used when LLM_MODE selects a direct provider.
# @sensitive
LLM_PROVIDER_API_KEY=

# Optional Langfuse tracing credentials.
# @sensitive
LANGFUSE_PUBLIC_KEY=
# @sensitive
LANGFUSE_SECRET_KEY=
# @type=url
LANGFUSE_HOST=

# OpenTelemetry resource and collector settings.
OTEL_SERVICE_NAME=nova-api
# @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
