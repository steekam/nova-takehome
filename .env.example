# Copy into ignored .env.local for local overrides. Varlock validates values against .env.schema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nova_hub
DATABASE_POOL_MAX=10
AUTH_SECRET=
PORT=3001
CORS_ORIGIN=http://localhost:5173
OTEL_ENABLED=true
VITE_API_URL=http://localhost:3001

# Keep mock mode for a no-key setup. Set the key only for live generation.
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=lesson-planner
LLM_GENERATOR_MODEL=lesson-planner
LLM_REVIEWER_MODEL=lesson-planner
LLM_API_KEY=
COMPOSE_LLM_BASE_URL=http://litellm:4000/v1
BASETEN_GENERATOR_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
BASETEN_REVIEWER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Local embedding model; no provider key required.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_DIR=.cache/embeddings
TRANSFORMERS_CACHE_DIR=.cache/transformers

# Optional OpenAI-compatible proxy profile (for example, local LiteLLM).
OPENAI_COMPATIBLE_PROXY_BASE_URL=http://localhost:4000/v1
OPENAI_COMPATIBLE_PROXY_API_KEY=
LITELLM_MODEL=lesson-planner
LITELLM_GENERATOR_MODEL=lesson-planner
LITELLM_REVIEWER_MODEL=lesson-planner
# Optional Langfuse integration.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3002
