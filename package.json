{
  "name": "nova-curriculum-hub",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "varlock run -- pnpm dev:apps",
    "dev:apps": "pnpm --filter @nova/shared build && pnpm --parallel --filter @nova/web --filter @nova/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @nova/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @nova/playground test && pnpm --filter @nova/api test:e2e",
    "db:generate": "pnpm --filter @nova/api db:generate",
    "db:migrate": "pnpm --filter @nova/api db:migrate",
    "db:seed": "pnpm --filter @nova/api db:seed",
    "local:prepare": "node ops/langfuse/prepare-local-env.mjs",
    "litellm:key": "varlock run -- node ops/litellm/provision-playground-key.mjs",
    "playground": "pnpm --filter @nova/playground build && varlock run -- node apps/playground/dist/cli.js",
    "openapi:generate": "pnpm --filter @nova/api openapi:export && pnpm --filter @nova/web openapi:types"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "varlock": "^1.21.0"
  },
  "varlock": {
    "loadPath": "./"
  }
}
