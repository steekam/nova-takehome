{
  "uid": "nova-api-telemetry",
  "title": "Nova API and model telemetry",
  "tags": ["nova", "api", "model"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status_code) (rate(nova_api_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status_code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP duration p95",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(nova_api_http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LiteLLM requests per second",
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (requested_model) (rate(litellm_proxy_total_requests_metric_total[5m]))",
          "legendFormat": "{{requested_model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LiteLLM spend by key and model",
      "gridPos": { "h": 10, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (api_key_alias, requested_model) (litellm_spend_metric_total)",
          "legendFormat": "{{api_key_alias}} · {{requested_model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LiteLLM provider latency p95",
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model_group) (rate(litellm_llm_api_latency_metric_bucket[5m])))",
          "legendFormat": "{{model_group}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Playground commands observed (30m)",
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (command, outcome) (last_over_time(nova_playground_command_count_total{service_name=\"nova-playground\"}[30m]))", "legendFormat": "{{command}} {{outcome}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Playground call cost observed (30m)",
      "gridPos": { "h": 10, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (stage, provider, model, kind) (last_over_time(nova_playground_cost_usd_USD_sum{service_name=\"nova-playground\"}[30m]))", "legendFormat": "{{stage}} {{provider}} {{model}} {{kind}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Evaluation score averages (30m)",
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (evaluation_metric, representation, model, model_revision, suite, live) (last_over_time(nova_playground_evaluation_score_sum{service_name=\"nova-playground\"}[30m])) / sum by (evaluation_metric, representation, model, model_revision, suite, live) (last_over_time(nova_playground_evaluation_score_count{service_name=\"nova-playground\"}[30m]))", "legendFormat": "{{evaluation_metric}} {{representation}} {{model}}@{{model_revision}} {{suite}} {{live}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Dataset items exported (30m)",
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (dataset, kind) (last_over_time(nova_playground_dataset_item_count_sum{service_name=\"nova-playground\"}[30m]))", "legendFormat": "{{dataset}} · {{kind}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "BGE embedding duration p95",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model, model_revision, provider) (last_over_time(nova_playground_embedding_duration_milliseconds_bucket{service_name=\"nova-playground\"}[30m])))",
          "legendFormat": "{{provider}} {{model}}@{{model_revision}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "BGE embedding cache reuse (30m)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result, model, model_revision) (last_over_time(nova_playground_embedding_cache_operations_total{service_name=\"nova-playground\"}[30m]))",
          "legendFormat": "{{result}} · {{model}}@{{model_revision}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "BGE model load duration p95",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model, model_revision, provider) (last_over_time(nova_playground_embedding_model_load_duration_milliseconds_bucket{service_name=\"nova-playground\"}[30m])))",
          "legendFormat": "{{provider}} {{model}}@{{model_revision}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "CBC review judge quality (30m)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 60 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (evaluation_metric, provider, model, route, live) (last_over_time(nova_playground_evaluation_score_sum{service_name=\"nova-playground\", suite=\"review_judge\", label_set=\"cbc-review-v3\"}[30m])) / sum by (evaluation_metric, provider, model, route, live) (last_over_time(nova_playground_evaluation_score_count{service_name=\"nova-playground\", suite=\"review_judge\", label_set=\"cbc-review-v3\"}[30m]))",
          "legendFormat": "{{evaluation_metric}} · {{provider}} {{model}} · {{route}} · live={{live}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Judge evaluation cost by provider/model (30m)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 70 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, model, kind) (last_over_time(nova_playground_cost_usd_USD_sum{service_name=\"nova-playground\", stage=\"review-eval\"}[30m]))",
          "legendFormat": "{{provider}} {{model}} · {{kind}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "API generation outcomes (30m)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 80 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (increase(nova_api_http_requests_total{route=\"/api/lesson-plans/generate\"}[30m]))",
          "legendFormat": "HTTP {{status_code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
