{
  "name": "@nova/api",
  "private": true,
  "version": "0.1.0",
  "varlock": {
    "loadPath": "../../"
  },
  "scripts": {
    "dev": "env NODE_ENV=development nest start --watch",
    "build": "nest build",
    "openapi:export": "pnpm --filter @nova/shared build && pnpm --filter @nova/model-runtime build && pnpm build && env NODE_ENV=development node dist/src/openapi.export.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p test/tsconfig.json",
    "test:e2e": "env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand --no-watchman",
    "db:generate": "pnpm --filter @nova/shared build && pnpm --filter @nova/model-runtime build && drizzle-kit generate",
    "db:migrate": "pnpm --filter @nova/shared build && pnpm --filter @nova/model-runtime build && drizzle-kit migrate",
    "db:seed": "pnpm --filter @nova/shared build && pnpm --filter @nova/model-runtime build && pnpm build && node dist/src/database/seed.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@huggingface/transformers": "^4.3.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nova/model-runtime": "workspace:*",
    "@nova/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.220.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.11.3",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "zod": "^4.0.0",
    "varlock": "^1.21.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11"
  }
}
