{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planVersionId": {
      "type": "string",
      "minLength": 1
    },
    "rubricVersion": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "enum": [
              "alignment",
              "grounding",
              "accuracy",
              "assessment",
              "feasibility",
              "safety",
              "accessibility"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "warning",
              "info"
            ]
          },
          "sectionPath": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidenceChunkIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ]
          },
          "signal": {
            "type": "string",
            "enum": [
              "rule",
              "jev",
              "llm",
              "human"
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "dimension",
          "severity",
          "sectionPath",
          "summary",
          "evidenceChunkIds",
          "suggestion",
          "signal",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "planVersionId",
    "rubricVersion",
    "findings"
  ],
  "additionalProperties": false
}
