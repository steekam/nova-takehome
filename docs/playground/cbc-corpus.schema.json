{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "cbc-corpus-v1"
    },
    "fixtures": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "particles",
              "changes"
            ]
          },
          "scenario": {
            "type": "object",
            "properties": {
              "curriculum": {
                "type": "string",
                "minLength": 1
              },
              "curriculumRelease": {
                "type": "string",
                "minLength": 1
              },
              "programme": {
                "type": "string",
                "minLength": 1
              },
              "grade": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "targetId": {
                "type": "string",
                "minLength": 1
              },
              "targetLocator": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "lessonFocus": {
                "type": "string",
                "minLength": 1
              },
              "durationMinutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "curriculum",
              "curriculumRelease",
              "programme",
              "grade",
              "subject",
              "targetId",
              "targetLocator",
              "target",
              "lessonFocus",
              "durationMinutes"
            ],
            "additionalProperties": false
          },
          "chunks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "documentId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "curriculum_target",
                    "scheme",
                    "teaching_note",
                    "assessment",
                    "lead_guidance",
                    "exemplar"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "synthetic": {
                  "type": "boolean"
                },
                "eligibleForGrounding": {
                  "type": "boolean",
                  "const": true
                },
                "targetId": {
                  "type": "string"
                },
                "sourceReference": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string"
                    },
                    "publisher": {
                      "type": "string"
                    },
                    "documentTitle": {
                      "type": "string"
                    },
                    "edition": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "locator": {
                      "type": "string"
                    },
                    "relationship": {
                      "type": "string",
                      "enum": [
                        "exact_excerpt",
                        "paraphrase"
                      ]
                    }
                  },
                  "required": [
                    "sourceId",
                    "publisher",
                    "documentTitle",
                    "edition",
                    "url",
                    "locator",
                    "relationship"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "documentId",
                "title",
                "kind",
                "text",
                "synthetic",
                "eligibleForGrounding"
              ],
              "additionalProperties": false
            }
          },
          "objectiveId": {
            "type": "string",
            "minLength": 1
          },
          "retrievalQuery": {
            "type": "string",
            "minLength": 1
          },
          "citationEvidence": {
            "type": "object",
            "properties": {
              "lessonFocusChunkId": {
                "type": "string",
                "minLength": 1
              },
              "mainActivityChunkId": {
                "type": "string",
                "minLength": 1
              },
              "assessmentChunkId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "lessonFocusChunkId",
              "mainActivityChunkId",
              "assessmentChunkId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "scenario",
          "chunks",
          "objectiveId",
          "retrievalQuery",
          "citationEvidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "fixtures"
  ],
  "additionalProperties": false
}
